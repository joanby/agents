# Requerido para LLM (agentes)
OPENAI_API_KEY=sk-...

# Opcional: API SEMrush para investigación de keywords. Si no está configurado, usa knowledge/keywords.csv
SEMRUSH_API_KEY=

# Opcional: API Serper para investigador de contenido (búsqueda web)
SERPER_API_KEY=

# Opcional: override paths
# DIRECTORY_CONTEXT_PATH=knowledge/contexto_directorio.md
# USER_PREFERENCE_PATH=knowledge/preferencias_usuario.txt
# KEYWORDS_CSV=knowledge/keywords.csv
# CALENDAR_PATH=output/calendario_editorial.md

# Calendario / modo de ejecución (para crewai run)
# CALENDAR_ONLY=1   → solo plan editorial
# DAY=3             → pipeline artículo para día 3 (tema del calendario)
# NUM_DAYS=20       → días del plan (default 20)
# TOPIC=...         → override tema (con DAY)
